# ---------------------------------------------------------------------------
# Copy to .env.local for development, or set these in your deploy environment.
#
# Every variable here is optional: the app boots and every tool works with none
# of them set. That is deliberate — nothing about the core product depends on
# configuration. What they control is the site's public identity (canonicals,
# sitemap, social cards), advertising, and analytics.
#
# All of these are NEXT_PUBLIC_*, which means they are inlined into the client
# bundle at build time and are visible to anyone who views source. That is
# correct for every value here — a publisher id and a domain are public facts —
# and it is the reason there is no secret in this file. If you ever add one,
# it does not belong on a NEXT_PUBLIC_ name.
#
# Because they are inlined at build time, changing one requires a rebuild.
# Setting it in a running container does nothing.
# ---------------------------------------------------------------------------

# Absolute origin, no trailing slash. Used for canonical URLs, the sitemap and
# OG tags. Leave it unset in development; the fallback is http://localhost:3000.
#
# IMPORTANT in production. Unset, the build publishes a robots.txt pointing at
# localhost and a sitemap full of URLs no crawler can reach — worse than
# publishing nothing, because it teaches the crawler the site is broken.
NEXT_PUBLIC_SITE_URL=https://thetoolzen.com

# Set to true on any deploy that is NOT production — previews, staging, a
# personal branch. It keeps the sitemap and robots.txt from advertising a host
# that competes with production for the same queries. Duplicate content is the
# one SEO problem that is expensive to undo.
#
# Note the limit of robots.txt alone: `Disallow: /` stops crawling, not
# indexing. A non-production host should also send an `X-Robots-Tag: noindex`
# header — vercel.json does this for preview deployments.
# NEXT_PUBLIC_NOINDEX=true

# ---------------------------------------------------------------------------
# Advertising
#
# Three independent switches, all required before a single ad script loads:
# the provider, the publisher id, and the enable flag. Miss any one and the app
# renders no ad markup at all — not an empty reservation, no markup — which is
# the intended failure mode. A missing publisher id in production costs revenue;
# a reserved 250px void on every page costs users.
#
# Turn these on only once the ad account is approved. Serving ads on a site
# that is not yet approved is the fastest way to have the application declined.
# ---------------------------------------------------------------------------

# The only provider wired up is "adsense". Anything else (or unset) is silent.
NEXT_PUBLIC_ADS_PROVIDER=none

# The master switch. Must be exactly the string "true".
NEXT_PUBLIC_ADS_ENABLED=false

# Google AdSense publisher id, e.g. ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_CLIENT=

# Per-placement slot ids, created in the AdSense dashboard. A placement with no
# id renders nothing, so a partly-configured account degrades to fewer ads
# rather than to broken empty boxes.
#
#   RAIL           300x600 vertical, beside the tool, 1280px and up only
#   AFTER_RESULT   300x250 rectangle, below the download button, after a result
#   AFTER_CONTENT  responsive, at the end of the article on a tool page
#   LISTING        728x90 horizontal, between rows on browse pages
#
# There is a hard ceiling of two units per page and the home, privacy and terms
# pages carry none. Both are enforced by scripts/check-integrity.mjs and by the
# page templates, not by whoever is editing this file.
NEXT_PUBLIC_ADSENSE_SLOT_RAIL=
NEXT_PUBLIC_ADSENSE_SLOT_AFTER_RESULT=
NEXT_PUBLIC_ADSENSE_SLOT_AFTER_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=

# Draws a labelled dashed outline where each reserved ad container sits, with
# its exact dimensions, so the layout can be reviewed at every breakpoint
# without a live account. For layout work only. It is emphatically not a fake
# advertisement: it is unclickable, says "reserved", and carries no headline.
NEXT_PUBLIC_ADS_DEBUG=false

# ---------------------------------------------------------------------------
# Analytics — cookieless, no personal data, no cross-site identifiers.
# Supported providers: "none" (default), "plausible", "umami".
# Both can be self-hosted on the same VPS.
#
# The privacy policy states that analytics here set no cookie and collect no
# personal data. Pointing these at something that does would make that page a
# lie, which is a worse problem than having no analytics.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=

# Search Console verification token. Only needed if you verify by meta tag
# rather than by DNS record — DNS is the better choice, because it survives a
# host change.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
