{
  "name": "toolzen",
  "version": "0.1.0",
  "private": true,
  "description": "Fast, private, browser-first online tools platform.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"src/lib/**/*.test.ts\"",
    "check": "node scripts/check-integrity.mjs && node scripts/check-icons.mjs",
    "verify": "npm run check && npm run test && npm run typecheck && npm run lint && npm run build",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "assets": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "next": "15.1.6",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.6",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.1.6",
    "postcss": "8.4.49",
    "sharp": "^0.35.4",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
